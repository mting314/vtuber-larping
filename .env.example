# Google Cloud Platform (GCP) Configuration
# Set your dedicated GCP Project ID here to isolate Vertex AI API usage & billing metrics
GCP_PROJECT=your-dedicated-gcp-project-id
GCP_LOCATION=us-central1

# Optional: Google Cloud Storage (GCS) Bucket Name
GCS_BUCKET_NAME=vtuber-summaries

# Optional: Gemini API Key (if using Google AI Studio API key instead of Vertex AI)
# GEMINI_API_KEY=your_api_key_here
